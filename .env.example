# Moyeoit (모여잇) Environment Variables Example

# Public Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://moyeoit-web.vercel.app

# Public Kakao JavaScript SDK Key
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=your-kakao-key

# Public Kakao AdFit Unit ID (Optional)
NEXT_PUBLIC_ADFIT_HOME=your-adfit-unit-id

# Public Google Analytics 4 Measurement ID (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Private Supabase Admin Configuration (Server-Only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Whitelist for /admin console (Server-Only, comma-separated list of emails)
# Users must be registered in Supabase Auth and have their email listed here.
ADMIN_EMAILS=admin@moyeoit.com,manager@moyeoit.com
