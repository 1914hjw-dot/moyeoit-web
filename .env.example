# Moyeoit (모여잇) Environment Variables Example

# Required on Vercel and for production builds
NEXT_PUBLIC_SITE_URL=https://moyeoit-web.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Private Supabase Admin Configuration (Server-Only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=your-random-cron-secret

# Admin Whitelist for /admin console (Server-Only, comma-separated list of emails)
# Users must be registered in Supabase Auth and have their email listed here.
ADMIN_EMAILS=admin@moyeoit.com,manager@moyeoit.com

# Public integrations (Optional)
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=your-kakao-key
NEXT_PUBLIC_ADFIT_HOME=your-adfit-unit-id
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: preferred distributed rate-limit backend. When omitted, the
# Supabase check_rate_limit() function from the baseline schema is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: set to 'true' only when deploying behind a trusted reverse proxy
# outside Vercel that overwrites x-forwarded-host / x-forwarded-for.
TRUST_PROXY=
